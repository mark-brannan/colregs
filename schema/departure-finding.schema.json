{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/departure-finding.schema.json",
  "title": "DepartureFinding",
  "description": "The result of evaluateDeparture: what a named grid found for a situation, with the rule-derived obligations unchanged beside it and the model that made the claim (ADR 0012 §4, ADR 0014). Advisories are ranked best margin first and are empty under no-robust-policy-in-model. Structure only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "rules",
    "advisories",
    "model"
  ],
  "properties": {
    "status": {
      "$ref": "departure-model.schema.json#/$defs/status"
    },
    "rules": {
      "$ref": "encounter-evaluation.schema.json"
    },
    "advisories": {
      "type": "array",
      "items": {
        "$ref": "departure-model.schema.json#/$defs/advisory"
      }
    },
    "model": {
      "$comment": "`version` names the grid, `colregs_version` the release it was solved against; a mismatch with rules.colregs.version is reported, not refused. `assumptions_violated` is display text, never matched on.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "colregs_version",
        "parameters",
        "assumptions_violated"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "colregs_version": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object",
          "allOf": [
            {
              "$ref": "departure-model.schema.json#/$defs/solverParameters"
            }
          ],
          "required": [
            "dynamics",
            "horizon_s",
            "cadence_s",
            "separation_m",
            "information",
            "adversary"
          ],
          "unevaluatedProperties": false
        },
        "assumptions_violated": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
