{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/scene-evaluation.schema.json",
  "title": "SceneEvaluation",
  "description": "The result of evaluateScene: every (self, other) pair through evaluateEncounter unchanged, the traffic reduced, and where the helm action one pair's duty asks for is foreclosed by another vessel (ADR 0023). Every field is pencil until the verb is written. Structure only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["pairs", "traffic", "conflicts"],
  "properties": {
    "pairs": {
      "$comment": "One per element of Scene.others, in order.",
      "type": "array",
      "items": { "$ref": "encounter-evaluation.schema.json" }
    },
    "traffic": { "$ref": "traffic-facts.schema.json" },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    }
  },
  "$defs": {
    "conflict": {
      "$comment": "`to` and `blocked_by` index Scene.others.",
      "type": "object",
      "additionalProperties": false,
      "required": ["duty", "to", "blocked_by"],
      "properties": {
        "duty": { "type": "string", "minLength": 1 },
        "to": { "type": "integer", "minimum": 0 },
        "blocked_by": { "type": "array", "items": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
