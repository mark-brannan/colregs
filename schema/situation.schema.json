{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/situation.schema.json",
  "title": "Situation",
  "description": "Two vessels and the encounter at one instant: the input evaluateEncounter reads, nested by subject and class (ADR 0005 §2, ADR 0011 §3, ADR 0014). Structure only -- every kin:/geo:/hist:/env: key must be declared in data/facts.json §situation, checked in the tests.",
  "$comment": "The same shape as a case's `situation` in schema/situation-fixtures.schema.json, stated once here so an operation can name it; `self` required, `other` optional (Rule 19's single-vessel scope), every class and key optional -- absent is absent.",
  "type": "object",
  "additionalProperties": false,
  "required": ["self"],
  "properties": {
    "self": { "$ref": "#/$defs/subject" },
    "other": { "$ref": "#/$defs/subject" },
    "pair": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geo": { "$ref": "#/$defs/geoRecord" },
        "env": { "$ref": "#/$defs/envRecord" }
      }
    }
  },
  "$defs": {
    "scalar": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["latitude", "longitude"],
          "properties": {
            "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
            "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        }
      ]
    },
    "kinRecord": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^kin:[a-z0-9_]+$": { "$ref": "#/$defs/scalar" } }
    },
    "geoRecord": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^geo:[a-z0-9_]+$": { "$ref": "#/$defs/scalar" } }
    },
    "histRecord": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^hist:[a-z0-9_]+$": { "$ref": "#/$defs/scalar" } }
    },
    "envRecord": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^env:[a-z0-9_]+$": { "$ref": "#/$defs/scalar" } }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact"],
      "properties": {
        "fact": { "$ref": "fact-record.schema.json" },
        "kin": { "$ref": "#/$defs/kinRecord" },
        "geo": { "$ref": "#/$defs/geoRecord" },
        "hist": { "$ref": "#/$defs/histRecord" }
      }
    }
  }
}
