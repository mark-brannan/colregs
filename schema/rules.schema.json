{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/rules.schema.json",
  "title": "data/rules.json",
  "description": "The language-neutral skeleton: paragraph paths, rule numbers, jurisdictions and figures. No text -- the words live in data/text/ corpora (schema/corpus.schema.json); the edition each jurisdiction consolidates is declared in data/editions.json. Structure only -- see docs/adr/0006-json-schema-and-identifier-diff.md, docs/adr/0003-language-as-a-dimension.md and docs/adr/0013-corpus-files-with-editions.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paragraphs"
  ],
  "properties": {
    "note": {
      "type": "string"
    },
    "paragraphs": {
      "$ref": "#/$defs/paragraphs"
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-jurisdiction skeleton deltas over `paragraphs` (ADR 0020): own paragraphs by path, suppressed paths, everything else inherited.",
      "patternProperties": {
        "^[a-z]+(/[a-z]+)+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "paragraphs",
            "suppressions"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "paragraphs": {
              "$ref": "#/$defs/paragraphs"
            },
            "suppressions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "why"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^[0-9]+(\\([a-z]\\))?(\\([ivx]+\\))?$"
                  },
                  "why": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "paragraphs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+(\\([a-z]\\))?(\\([ivx]+\\))?$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "rule",
            "jurisdiction"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[0-9]+(\\([a-z]\\))?(\\([ivx]+\\))?$"
            },
            "rule": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "jurisdiction": {
              "type": "string",
              "pattern": "^[a-z]+(/[a-z]+)*$"
            },
            "images": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      }
    }
  }
}
