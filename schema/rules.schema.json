{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/rules.schema.json",
  "title": "data/rules.json",
  "description": "The language-neutral skeleton: paragraph paths, rule numbers, jurisdictions and figures. No text -- the words live in data/text/ corpora (schema/corpus.schema.json). Structure only -- see docs/adr/0006-json-schema-and-identifier-diff.md, docs/adr/0003-language-as-a-dimension.md and docs/adr/0013-corpus-files.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "amendment_state",
    "paragraphs"
  ],
  "properties": {
    "note": {
      "type": "string"
    },
    "amendment_state": {
      "$comment": "REQ-LANG-10: the amendment state the skeleton consolidates, per jurisdiction. A corpus declares its own; the two may differ, machine-visibly.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z]+(/[a-z]+)*$": {
          "$comment": "Same shape as a corpus's amendment_state (schema/corpus.schema.json); inlined because each schema compiles alone.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amended_through",
            "in_force"
          ],
          "properties": {
            "amended_through": {
              "type": "string",
              "minLength": 1
            },
            "in_force": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "paragraphs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[0-9]+(\\([a-z]\\))?(\\([ivx]+\\))?$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "rule",
            "jurisdiction"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^[0-9]+(\\([a-z]\\))?(\\([ivx]+\\))?$"
            },
            "rule": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "jurisdiction": {
              "type": "string",
              "pattern": "^[a-z]+(/[a-z]+)*$"
            },
            "images": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          }
        }
      }
    }
  }
}
