{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/facts.schema.json",
  "title": "data/facts.json",
  "description": "The input vocabulary a fact record is evaluated against. Structure only -- see docs/adr/0006-json-schema-and-identifier-diff.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axes"
  ],
  "$defs": {
    "factKey": {
      "type": "string",
      "pattern": "^fact:[a-z0-9_]+$"
    },
    "factValue": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$"
    },
    "constraint": {
      "oneOf": [
        { "$ref": "#/$defs/factValue" },
        { "type": "boolean" },
        { "type": "number" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/factValue" }
        },
        { "$ref": "#/$defs/numericGate" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": { "$ref": "#/$defs/constraint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/constraint" }
            }
          }
        }
      ]
    },
    "numericGate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gte": {
          "type": "number"
        },
        "gt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        }
      }
    },
    "situationFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "cite",
        "cite_pending",
        "actuable"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "number",
            "boolean",
            "enum",
            "position"
          ]
        },
        "unit": {
          "type": "string"
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/factValue"
          }
        },
        "cite": {
          "type": [
            "string",
            "null"
          ]
        },
        "cite_pending": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        },
        "actuable": {
          "type": "boolean"
        },
        "signalk": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "properties": {
    "note": {
      "type": "string"
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/factValue"
              }
            },
            "cites": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "boolean",
                "number",
                "string"
              ]
            },
            "refines": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "actuable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "cite"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "number"
            },
            "unit": {
              "type": "string"
            },
            "cite": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string"
            },
            "actuable": {
              "type": "boolean"
            },
            "signalk": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "booleans": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cite",
            "actuable"
          ],
          "properties": {
            "cite": {
              "type": "string",
              "minLength": 1
            },
            "actuable": {
              "type": "boolean"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "values",
            "cite"
          ],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/factValue"
              }
            },
            "cite": {
              "type": "string",
              "minLength": 1
            },
            "actuable": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "derived", "cite", "decode", "actuable"],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["number", "boolean", "enum"]
            },
            "derived": {
              "const": true
            },
            "cite": {
              "type": "string",
              "minLength": 1
            },
            "unit": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/factValue" }
            },
            "cites": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "actuable": {
              "const": false
            },
            "signalk": {
              "type": ["string", "null"]
            },
            "note": {
              "type": "string"
            },
            "decode": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["when", "value"],
                "properties": {
                  "when": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": false,
                    "patternProperties": {
                      "^fact:[a-z0-9_]+$": { "$ref": "#/$defs/constraint" }
                    }
                  },
                  "value": {
                    "oneOf": [
                      { "$ref": "#/$defs/factValue" },
                      { "type": "boolean" },
                      { "type": "number" }
                    ]
                  },
                  "cite": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            },
            "undecodable": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["case", "why"],
                "properties": {
                  "case": { "type": "string" },
                  "why": { "type": "string" },
                  "cite": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "actuable_subset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": {
          "type": "string"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/factKey"
          }
        }
      }
    },
    "signalk_navigation_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string"
        },
        "verified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "decode": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact:propulsion": {
                "$ref": "#/$defs/factValue"
              },
              "fact:activity": {
                "$ref": "#/$defs/factValue"
              },
              "fact:position": {
                "$ref": "#/$defs/factValue"
              },
              "fact:tow_length_m": {
                "$ref": "#/$defs/numericGate"
              },
              "also_activity": {
                "$ref": "#/$defs/factValue"
              },
              "annex_ii_signal": {
                "type": "string"
              }
            }
          }
        },
        "undecodable": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lossy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "what",
              "why"
            ],
            "properties": {
              "what": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "cite": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "situation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "kinematics",
        "geometry",
        "history",
        "record",
        "environment"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "constants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "patternProperties": {
            "^(?!note$)[a-z][a-z0-9_]*$": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value",
                "fact",
                "status",
                "cite",
                "cite_pending"
              ],
              "properties": {
                "value": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "fact": {
                  "type": "string"
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ink",
                    "pencil",
                    "open"
                  ]
                },
                "cite": {
                  "type": ["string", "null"]
                },
                "cite_pending": {
                  "type": ["string", "null"]
                },
                "note": {
                  "type": "string"
                },
                "settled_by": {
                  "type": "string"
                }
              }
            }
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "ink",
            "pencil",
            "open"
          ]
        },
        "adr": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^REQ-[A-Z]+-[0-9]+$"
          }
        },
        "pencil": {
          "type": "string"
        },
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "form",
            "subjects",
            "classes"
          ],
          "properties": {
            "form": {
              "type": "string"
            },
            "doc": {
              "type": "string"
            },
            "subjects": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "own",
                "other",
                "pair"
              ],
              "properties": {
                "own": {
                  "type": "string"
                },
                "other": {
                  "type": "string"
                },
                "pair": {
                  "type": "string"
                }
              }
            },
            "classes": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact",
                "kin",
                "geo",
                "hist",
                "env"
              ],
              "properties": {
                "fact": {
                  "type": "string"
                },
                "kin": {
                  "type": "string"
                },
                "geo": {
                  "type": "string"
                },
                "hist": {
                  "type": "string"
                },
                "env": {
                  "type": "string"
                }
              }
            },
            "bare_key": {
              "type": "string"
            },
            "directional_note": {
              "type": "string"
            }
          }
        },
        "kinematics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "patternProperties": {
            "^kin:[a-z0-9_]+$": {
              "$ref": "#/$defs/situationFact"
            }
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "directional",
            "symmetric"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "directional": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "note": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^geo:[a-z0-9_]+$": {
                  "$ref": "#/$defs/situationFact"
                }
              }
            },
            "symmetric": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "note": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^geo:[a-z0-9_]+$": {
                  "$ref": "#/$defs/situationFact"
                }
              }
            },
            "consistency": {
              "type": "object"
            }
          }
        },
        "history": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "patternProperties": {
            "^hist:[a-z0-9_]+$": {
              "$ref": "#/$defs/situationFact"
            }
          }
        },
        "record": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "shape"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "shape": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "own",
                "other",
                "pair"
              ],
              "properties": {
                "own": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "fact": {
                      "type": "string"
                    },
                    "kin": {
                      "type": "string"
                    },
                    "geo": {
                      "type": "string"
                    },
                    "hist": {
                      "type": "string"
                    }
                  }
                },
                "other": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "fact": {
                      "type": "string"
                    },
                    "kin": {
                      "type": "string"
                    },
                    "geo": {
                      "type": "string"
                    },
                    "hist": {
                      "type": "string"
                    }
                  }
                },
                "pair": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "geo": {
                      "type": "string"
                    },
                    "env": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "note": {
              "type": "string"
            }
          },
          "patternProperties": {
            "^env:[a-z0-9_]+$": {
              "$ref": "#/$defs/situationFact"
            }
          }
        }
      }
    }
  }
}
