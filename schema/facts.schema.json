{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/facts.schema.json",
  "title": "data/facts.json",
  "description": "The input vocabulary a fact record is evaluated against. Structure only -- see docs/adr/0005-json-schema-and-identifier-diff.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["axes"],
  "$defs": {
    "factKey": { "type": "string", "pattern": "^fact:[a-z0-9_]+$" },
    "factValue": { "type": "string", "pattern": "^[a-z_]+:[a-z0-9_]+$" },
    "numericGate": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "gte": { "type": "number" },
        "gt": { "type": "number" },
        "lte": { "type": "number" },
        "lt": { "type": "number" }
      }
    }
  },
  "properties": {
    "note": { "type": "string" },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/factValue" }
            },
            "cites": {
              "type": "object",
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "note": { "type": "string" }
          }
        }
      }
    },
    "modifiers": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "enum": ["boolean", "number", "string"] },
            "refines": { "type": "string" },
            "note": { "type": "string" },
            "actuable": { "type": "boolean" }
          }
        }
      }
    },
    "numerics": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "cite"],
          "properties": {
            "type": { "type": "string", "const": "number" },
            "unit": { "type": "string" },
            "cite": { "type": "string", "minLength": 1 },
            "note": { "type": "string" },
            "actuable": { "type": "boolean" },
            "signalk": { "type": ["string", "null"] }
          }
        }
      }
    },
    "booleans": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cite", "actuable"],
          "properties": {
            "cite": { "type": "string", "minLength": 1 },
            "actuable": { "type": "boolean" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "enums": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^fact:[a-z0-9_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values", "cite"],
          "properties": {
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/factValue" }
            },
            "cite": { "type": "string", "minLength": 1 },
            "actuable": { "type": "boolean" }
          }
        }
      }
    },
    "actuable_subset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "note": { "type": "string" },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/$defs/factKey" }
        }
      }
    },
    "signalk_navigation_state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "decode": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "fact:propulsion": { "$ref": "#/$defs/factValue" },
              "fact:activity": { "$ref": "#/$defs/factValue" },
              "fact:position": { "$ref": "#/$defs/factValue" },
              "fact:tow_length_m": { "$ref": "#/$defs/numericGate" },
              "also_activity": { "$ref": "#/$defs/factValue" },
              "annex_ii_signal": { "type": "string" }
            }
          }
        },
        "undecodable": {
          "type": "array",
          "items": { "type": "string" }
        },
        "lossy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["what", "why"],
            "properties": {
              "what": { "type": "string" },
              "why": { "type": "string" },
              "cite": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
