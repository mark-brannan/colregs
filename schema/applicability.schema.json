{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mark-brannan/colregs/schema/applicability.schema.json",
  "title": "data/applicability.json",
  "description": "predicate -> lights and day shapes, per entry, with modality, citation and jurisdiction. Structure only -- see docs/adr/0006-json-schema-and-identifier-diff.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "$defs": {
    "ruleCategory": {
      "type": "string",
      "enum": [
        "category:definition",
        "category:standard",
        "category:scope",
        "category:display",
        "category:classification",
        "category:precedence",
        "category:conduct",
        "category:care",
        "category:meta"
      ]
    },
    "ruleId": { "type": "string", "pattern": "^rule:[0-9]+[a-z]?(_[ivx]+)*(:[a-z][a-z0-9_]*)?$" },
    "modality": {
      "type": "string",
      "enum": ["modality:shall", "modality:may", "modality:shall-if-practicable", "modality:conditional", "modality:exempt", "modality:shall-not", "modality:shall-not-impede"]
    },
    "predicateValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "gte": { "type": "number" },
            "gt": { "type": "number" },
            "lte": { "type": "number" },
            "lt": { "type": "number" }
          }
        },
        { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$" },
        { "type": "boolean" },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*:[a-z0-9_]+$" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": {
            "not": { "$ref": "#/$defs/predicateValue" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": {
            "any_of": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/predicateValue" }
            }
          }
        }
      ]
    },
    "when": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/when" }
        }
      },
      "patternProperties": {
        "^fact:[a-z0-9_]+$": { "$ref": "#/$defs/predicateValue" }
      }
    },
    "situationWhen": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "any_of": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/situationWhen" }
        }
      },
      "patternProperties": {
        "^fact:[a-z0-9_]+$": { "$ref": "#/$defs/predicateValue" },
        "^(self|other):(fact|kin|geo|hist):[a-z0-9_]+$": { "$ref": "#/$defs/predicateValue" },
        "^pair:(geo|env):[a-z0-9_]+$": { "$ref": "#/$defs/predicateValue" }
      }
    },
    "effectRole": {
      "type": "string",
      "enum": ["role:give-way", "role:stand-on", "role:shall-not-impede", "role:keep-clear", "role:none"]
    },
    "effect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["part", "section", "applies_rules"],
          "properties": {
            "part": { "type": "string" },
            "section": { "type": "string" },
            "applies_rules": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["self", "other"],
          "properties": {
            "self": { "$ref": "#/$defs/effectRole" },
            "other": { "$ref": "#/$defs/effectRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["encounter"],
          "properties": {
            "encounter": {
              "type": "string",
              "enum": ["encounter:head-on", "encounter:crossing", "encounter:overtaking", "encounter:none"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["risk_of_collision"],
          "properties": {
            "risk_of_collision": { "const": true }
          }
        }
      ]
    },
    "lightRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["light"],
      "properties": {
        "light": { "type": "string", "pattern": "^light:[a-z_]+$" },
        "position": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "color": { "type": "string" },
        "character": { "type": "string" },
        "intensity": { "type": "string" },
        "arrangement": { "type": "string", "enum": ["vertical"] },
        "combined": { "type": "boolean" },
        "note": { "type": "string" },
        "modality": { "$ref": "#/$defs/modality" }
      }
    },
    "shapeRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": { "type": "string", "pattern": "^shape:[a-z_]+$" },
        "position": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "arrangement": { "type": "string", "enum": ["vertical"] },
        "note": { "type": "string" },
        "modality": { "$ref": "#/$defs/modality" }
      }
    },
    "shiftId": {
      "$comment": "A modality shift is not an entry and does not live in the `rule:` namespace, so it takes its own prefix (docs/identifiers.md, `The scheme`).",
      "type": "string",
      "pattern": "^shift:[0-9]+[a-z]?(_[ivx]+)*(:[a-z][a-z0-9_]*)?$"
    },
    "modalityBy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["when", "modality"],
        "properties": {
          "when": { "$ref": "#/$defs/when" },
          "modality": { "$ref": "#/$defs/modality" }
        }
      }
    },
    "conditionalInclude": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "when": { "$ref": "#/$defs/when" },
        "one_of": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/ruleId" }
        },
        "rel:includes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ruleId" }
        },
        "cite": { "type": "string", "minLength": 1 }
      }
    },
    "ruleIdList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ruleId" }
    }
  },
  "properties": {
    "conditions": { "type": "string" },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rel:includes",
        "rel:conditional_includes",
        "rel:in_lieu_of",
        "rel:excludes",
        "rel:exempts",
        "rel:overrides"
      ],
      "properties": {
        "rel:includes": { "type": "string" },
        "rel:conditional_includes": { "type": "string" },
        "rel:in_lieu_of": { "type": "string" },
        "rel:excludes": { "type": "string" },
        "rel:exempts": { "type": "string" },
        "rel:overrides": { "type": "string" }
      }
    },
    "modalities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modality:shall",
        "modality:may",
        "modality:shall-if-practicable",
        "modality:conditional",
        "modality:exempt",
        "modality:shall-not",
        "modality:shall-not-impede"
      ],
      "properties": {
        "modality:shall": { "type": "string" },
        "modality:may": { "type": "string" },
        "modality:shall-if-practicable": { "type": "string" },
        "modality:conditional": { "type": "string" },
        "modality:exempt": { "type": "string" },
        "modality:shall-not": { "type": "string" },
        "modality:shall-not-impede": { "type": "string" }
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category:definition",
        "category:standard",
        "category:scope",
        "category:display",
        "category:classification",
        "category:precedence",
        "category:conduct",
        "category:care",
        "category:meta"
      ],
      "properties": {
        "category:definition": { "type": "string" },
        "category:standard": { "type": "string" },
        "category:scope": { "type": "string" },
        "category:display": { "type": "string" },
        "category:classification": { "type": "string" },
        "category:precedence": { "type": "string" },
        "category:conduct": { "type": "string" },
        "category:care": { "type": "string" },
        "category:meta": { "type": "string" }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "note": { "type": "string" },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role:give-way", "role:stand-on", "role:shall-not-impede", "role:keep-clear", "role:none"],
          "properties": {
            "role:give-way": { "type": "string" },
            "role:stand-on": { "type": "string" },
            "role:shall-not-impede": { "type": "string" },
            "role:keep-clear": { "type": "string" },
            "role:none": { "type": "string" }
          }
        },
        "encounters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encounter:head-on", "encounter:crossing", "encounter:overtaking", "encounter:none"],
          "properties": {
            "encounter:head-on": { "type": "string" },
            "encounter:crossing": { "type": "string" },
            "encounter:overtaking": { "type": "string" },
            "encounter:none": { "type": "string" }
          }
        },
        "classification_shape": { "type": "string" }
      }
    },
    "suppressions": {
      "$comment": "Tombstones (REQ-SCOPE-3, ADR 0018): a jurisdiction deliberately lacks an inherited intl entry, as distinct from not-yet-transcribed. With the jurisdiction's own entries these form its RFC 7396 merge patch over intl; suppresses is the key that patch sets to null.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["jurisdiction", "suppresses", "cite", "why"],
        "properties": {
          "jurisdiction": { "type": "string", "pattern": "^[a-z]+(/[a-z]+)+$" },
          "suppresses": { "$ref": "#/$defs/ruleId" },
          "cite": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "modality_shifts": {
      "$comment": "Rule 20(c) as a modality shift (ADR 0021): a paragraph that changes the modality of the signals other entries prescribe, rather than prescribing signals of its own. `when` is the ordinary predicate language over the fact record; `applies_to` is the signal kind reached; `map` is applied to a signal's already-resolved modality, `modality_by` included, and a modality that is not a key of `map` is left alone.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "jurisdiction", "cite", "applies_to", "when", "map"],
        "properties": {
          "id": { "$ref": "#/$defs/shiftId" },
          "jurisdiction": { "type": "string", "pattern": "^[a-z]+(/[a-z]+)*$" },
          "cite": { "type": "string", "minLength": 1 },
          "applies_to": { "type": "string", "enum": ["lights", "shapes"] },
          "when": { "$ref": "#/$defs/when" },
          "map": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "propertyNames": { "$ref": "#/$defs/modality" },
            "patternProperties": { "^modality:[a-z-]+$": { "$ref": "#/$defs/modality" } }
          },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "known_omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cite", "what", "why"],
        "properties": {
          "cite": { "type": "string", "minLength": 1 },
          "what": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "represented_paragraphs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "jurisdiction", "cite", "category", "note"],
        "properties": {
          "id": { "$ref": "#/$defs/ruleId" },
          "jurisdiction": { "type": "string", "pattern": "^[a-z]+(/[a-z]+)*$" },
          "cite": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["category:care", "category:meta", "category:scope"] },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "jurisdiction", "cite", "when", "modality"],
        "properties": {
          "id": { "$ref": "#/$defs/ruleId" },
          "jurisdiction": { "type": "string", "pattern": "^[a-z]+(/[a-z]+)*$" },
          "cite": { "type": "string", "minLength": 1 },
          "category": {
            "$ref": "#/$defs/ruleCategory"
          },
          "subjects": { "type": "integer", "const": 2 },
          "when": { "$ref": "#/$defs/situationWhen" },
          "lights": {
            "type": "array",
            "items": { "$ref": "#/$defs/lightRef" }
          },
          "shapes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/shapeRef" }
          },
          "effect": { "$ref": "#/$defs/effect" },
          "modality": { "$ref": "#/$defs/modality" },
          "modality_by": { "$ref": "#/$defs/modalityBy" },
          "images": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" },
          "note": { "type": "string" },
          "gap": { "type": "string", "minLength": 1 },
          "no_gate_note": { "type": "string", "minLength": 1 },
          "rel:includes": { "$ref": "#/$defs/ruleIdList" },
          "rel:conditional_includes": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/conditionalInclude" }
          },
          "rel:in_lieu_of": { "$ref": "#/$defs/ruleIdList" },
          "rel:excludes": { "$ref": "#/$defs/ruleIdList" },
          "rel:exempts": { "$ref": "#/$defs/ruleIdList" },
          "rel:overrides": { "$ref": "#/$defs/ruleIdList" }
        },
        "allOf": [
          {
            "if": {
              "properties": { "subjects": { "const": 2 } },
              "required": ["subjects"]
            },
            "then": {
              "properties": { "category": {}, "effect": {} },
              "required": ["category", "effect"],
              "not": { "properties": { "lights": {} }, "required": ["lights"] }
            },
            "else": {
              "properties": { "lights": {} },
              "required": ["lights"],
              "not": { "properties": { "effect": {} }, "required": ["effect"] }
            }
          }
        ]
      }
    }
  }
}
