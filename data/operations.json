{
  "note": "The engine interface colregs owns (ADR 0014, ADR 0023): six operations, one per thing evaluated, each with what it reads, what it answers, and the fixture cases that bind it. A replay compares a case's `expect` to the answer's `applied` unless the fixture file says otherwise.",
  "operations": {
    "evaluateDisplay": {
      "adr": "0011",
      "inputs": [
        {
          "name": "facts",
          "schema": "schema/fact-record.schema.json"
        }
      ],
      "output": "schema/display-evaluation.schema.json",
      "fixtures": [
        {
          "file": "fixtures/applicability-fixtures.json",
          "case_inputs": [
            "facts"
          ],
          "expect": "schema/evaluation.schema.json#/$defs/ruleIds"
        }
      ]
    },
    "evaluateEncounter": {
      "adr": "0011",
      "inputs": [
        {
          "name": "situation",
          "schema": "schema/situation.schema.json"
        }
      ],
      "output": "schema/encounter-evaluation.schema.json",
      "fixtures": [
        {
          "file": "fixtures/situation-fixtures.json",
          "case_inputs": [
            "situation"
          ],
          "expect": "schema/evaluation.schema.json#/$defs/ruleIds"
        }
      ]
    },
    "evaluateConduct": {
      "adr": "0012",
      "inputs": [
        {
          "name": "trace",
          "schema": "schema/trace.schema.json"
        }
      ],
      "output": "schema/conduct-evaluation.schema.json",
      "fixtures": []
    },
    "evaluateDeparture": {
      "adr": "0012",
      "inputs": [
        {
          "name": "situation",
          "schema": "schema/situation.schema.json"
        },
        {
          "name": "model",
          "schema": "schema/departure-model.schema.json"
        }
      ],
      "output": "schema/departure-finding.schema.json",
      "fixtures": []
    },
    "evaluateScene": {
      "adr": "0023",
      "inputs": [
        {
          "name": "scene",
          "schema": "schema/scene.schema.json"
        }
      ],
      "output": "schema/scene-evaluation.schema.json",
      "fixtures": []
    },
    "reduceTraffic": {
      "adr": "0023",
      "inputs": [
        {
          "name": "self",
          "schema": "schema/situation.schema.json#/$defs/subject"
        },
        {
          "name": "others",
          "schema": "schema/scene.schema.json#/$defs/subjects"
        }
      ],
      "output": "schema/traffic-facts.schema.json",
      "fixtures": []
    }
  }
}
