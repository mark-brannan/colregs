{
  "note": "The engine interface colregs owns: each verb ADR 0011 and ADR 0012 name, what it reads, what it answers, its entry-id companion and the fixture cases that bind it (ADR 0014).",
  "operations": {
    "evaluateDisplay": {
      "adr": "0011",
      "inputs": [
        {
          "name": "facts",
          "schema": "schema/fact-record.schema.json"
        }
      ],
      "output": "schema/display-evaluation.schema.json",
      "companion": {
        "verb": "appliedDisplayEntries",
        "output": "schema/evaluation.schema.json#/$defs/ruleIds"
      },
      "fixtures": [
        {
          "file": "fixtures/applicability-fixtures.json",
          "case_inputs": [
            "facts"
          ]
        }
      ]
    },
    "evaluateEncounter": {
      "adr": "0011",
      "inputs": [
        {
          "name": "situation",
          "schema": "schema/situation.schema.json"
        }
      ],
      "output": "schema/encounter-evaluation.schema.json",
      "companion": {
        "verb": "appliedEncounterEntries",
        "output": "schema/evaluation.schema.json#/$defs/ruleIds"
      },
      "fixtures": [
        {
          "file": "fixtures/situation-fixtures.json",
          "case_inputs": [
            "situation"
          ]
        }
      ]
    },
    "evaluateConduct": {
      "adr": "0012",
      "inputs": [
        {
          "name": "trace",
          "schema": "schema/trace.schema.json"
        }
      ],
      "output": "schema/conduct-evaluation.schema.json",
      "companion": {
        "verb": "appliedConductEntries",
        "output": "schema/evaluation.schema.json#/$defs/ruleIds"
      },
      "fixtures": []
    },
    "evaluateRule2Departure": {
      "adr": "0012",
      "inputs": [
        {
          "name": "situation",
          "schema": "schema/situation.schema.json"
        },
        {
          "name": "model",
          "schema": "schema/rule2-departure-model.schema.json"
        }
      ],
      "output": "schema/rule2-departure-finding.schema.json",
      "fixtures": []
    }
  }
}
