{
 "printWidth": 120,
 "tabWidth": 1,
 "useTabs": false,
 "semi": false,
 "singleQuote": true,
 "trailingComma": "all",
 "bracketSpacing": true,
 "arrowParens": "always",
 "endOfLine": "lf",
 "overrides": [
  { "files": ["data/**/*.json", "fixtures/**/*.json"], "options": { "parser": "json-stringify", "tabWidth": 1 } },
  { "files": ["schema/**/*.json"], "options": { "tabWidth": 2 } }
 ]
}
