{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["data/**/*.json", "fixtures/**/*.json"], "options": { "parser": "json-stringify", "tabWidth": 1 } },
    { "files": ["schema/**/*.json"], "options": { "printWidth": 100, "tabWidth": 2 } }
  ]
}
